{
	"$schema": "node_modules/turbo/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"inputs": ["src/**", "package.json", "tsconfig.json"]
		},
		"clean": {
			"cache": false
		},
		"comments:fix": {
			"outputs": [],
			"cache": false
		},
		"lint": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"lint:fix": {
			"dependsOn": ["^build"],
			"outputs": [],
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": ["src/**", "package.json", "vitest.config.*"]
		},
		"test:coverage": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"],
			"inputs": ["src/**", "package.json", "vitest.config.*"]
		}
	}
}
