{
	"name": "root",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"description": "Monorepo of small Node CLI helpers, such as logger, run, perf, bundlesize, etc.",
	"scripts": {
		"build": "turbo run build",
		"comments:fix": "turbo run comments:fix",
		"fix": "npm-run-all --serial comments:fix lint:fix",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"lint-staged": "lint-staged --config \"./configuration/lint-staged.config.cjs\"",
		"prepare": "husky",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@node-cli/comments": "workspace:*",
		"@swc/cli": "0.8.1",
		"@swc/core": "1.16.18",
		"@types/node": "26.6.5",
		"@versini/dev-dependencies-common": "15.0.0",
		"barrelsby": "2.8.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"npm-check-updates": "23.1.1",
		"npm-run-all2": "9.0.3",
		"rimraf": "6.1.3",
		"turbo": "2.11.9",
		"typescript": "6.0.3",
		"vite": "8.3.4"
	},
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=22"
	}
}
